# Only configure email after recipient/event authorization; credentials do not grant it.
# Copy to a private path outside artifact pullback scope and chmod 600 it.
# Never commit the real file or print its values. Wrapper notifications default off.
# Explicitly enable NOTIFY_ENABLED=1 in the authorized launch environment.

# QQ Mail example:
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_TLS=true

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true

SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_app_password
MAIL_FROM=your_email@qq.com
MAIL_TO=receiver@example.com
